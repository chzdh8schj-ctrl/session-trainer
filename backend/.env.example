# Скопируй в backend/.env и заполни. Значения ниже — заглушки.

# Пароль для входа на сайт (один на всех) — хранится хешем scrypt.
# Сгенерировать: uv run python -m app.passwords "твой пароль"
# и вставить сюда всю строку целиком (scrypt$16384$8$1$...).
SITE_PASSWORD_HASH=

# Запасной вариант: открытый пароль. Работает, только если SITE_PASSWORD_HASH пуст,
# на старте хешируется в памяти и в лог не попадает. Лучше так не оставлять.
SITE_PASSWORD=

# Секрет для подписи куки сессии. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Ключ DeepSeek (https://platform.deepseek.com). Пусто — ИИ выключен, части заполняются вручную
DEEPSEEK_API_KEY=

# Срок жизни куки в днях, по умолчанию 30
SESSION_DAYS=30
# Ставить куку только по HTTPS (на сервере с TLS — true, локально false)
COOKIE_SECURE=false

# DeepSeek: адрес, модель, таймаут одного запроса в секундах
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# Цены за 1M токенов в USD и курс пересчёта в рубли
PRICE_IN_USD=0.27
PRICE_OUT_USD=1.10
USD_RUB=81

# Месячный лимит расхода ИИ в рублях по умолчанию (дальше правится в /admin)
DEFAULT_LIMIT_RUB=500

# Файл базы SQLite (относительно каталога backend)
APP_DB_PATH=data/app.db

# Адрес и порт сервера
APP_HOST=127.0.0.1
APP_PORT=8010

# Каталог собранного фронтенда (относительно каталога backend)
FRONTEND_DIST=../frontend/dist
